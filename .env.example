# 复制成 .env 只在本地用；GitHub 上请配置成仓库 Secrets。
# 不要提交真实的 key。

# —— LLM 打分（OpenAI 兼容接口，三选一即可）——
# DeepSeek（便宜，推荐）：https://platform.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 或 OpenAI：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 或通义/智谱/月之暗面等任何 OpenAI 兼容网关，改 base_url + model 即可

# —— OpenAlex（可选，免费申请，可显著减少 429 限流）——
# https://openalex.org/rest-api
OPENALEX_API_KEY=

# —— 可选：把结果推到群里 ——
# NOTIFY_WEBHOOK=
# NOTIFY_TYPE=feishu   # feishu | dingtalk | slack | serverchan | bark | generic
# NOTIFY_TOP_N=10

# —— 学术 API 的礼貌标识（会被写进请求头 / mailto）——
# CONTACT_EMAIL=you@example.com
